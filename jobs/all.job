#!/bin/bash
#SBATCH --job-name=avb-all
#SBATCH --output=logs/all_%j.out
#SBATCH --error=logs/all_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=14:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=END,FAIL

# Full pipeline: every experiment + every plot, in dependency order.
#
# Stages (toggleable via env vars):
#   1a. canonical-pair single-pair experiments
#   1b. text-free-pair A and B  (auto-suffixed by encoder name)
#   1c. text-free-pair cross-modal recipes  (--out-suffix)
#   1d. full encoder grid  (262 cells, ~8h -- skip with SKIP_GRID=1)
#   2a. per-experiment plots and comparison tables
#   2b. grid plots
#   2c-f. geometry / ranks / levels / trade-off analyses
#   2g-j. qualitative panels, A/B grid tables, best-plan renders, chapter

set -e
set -x

PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs results/exp_grid/plots results/comparison_plots results/plots

# --- Encoder choice (overridable from sbatch env) ---
CANONICAL_IMG="${CANONICAL_IMG:-clip-large}"
CANONICAL_AUD="${CANONICAL_AUD:-clap-unfused}"
FREE_IMG="${FREE_IMG:-dinov2-large}"
FREE_AUD="${FREE_AUD:-mert-330m}"
FREE_SUFFIX="__${FREE_IMG}__${FREE_AUD}"

# --- Optional gating flags ---
SKIP_GRID="${SKIP_GRID:-0}"          # 1 to skip the 8h grid sweep
SKIP_TEXTFREE="${SKIP_TEXTFREE:-0}"  # 1 to skip the second encoder pair

##############################################################################
# Stage 1: experiments
##############################################################################

echo "=== 1a. canonical pair: ${CANONICAL_IMG} x ${CANONICAL_AUD} ==="
python code/run_experiments.py --exp all \
    --image-encoder "$CANONICAL_IMG" --audio-encoder "$CANONICAL_AUD"

if [ "$SKIP_TEXTFREE" = "0" ]; then
    echo "=== 1b. text-free A and B (auto-suffixed by encoder name) ==="
    python code/run_experiments.py --exp a --image-encoder "$FREE_IMG"
    python code/run_experiments.py --exp b --audio-encoder "$FREE_AUD"

    echo "=== 1c. text-free cross-modal recipes (--out-suffix ${FREE_SUFFIX}) ==="
    # NOTE: c-transitive triggers the full K x alpha sweep (8 K x 5 alpha
    # = 40 cells, ~20 min) at the text-free pair, mirroring stage 1a
    # for the canonical pair.
    for EXP in c-transitive d unsup text random procrustes direct; do
        python code/run_experiments.py --exp "$EXP" \
            --image-encoder "$FREE_IMG" --audio-encoder "$FREE_AUD" \
            --out-suffix "$FREE_SUFFIX"
    done
fi

if [ "$SKIP_GRID" = "0" ]; then
    echo "=== 1d. full encoder grid (~8h) ==="
    python code/run_experiments.py --exp grid
fi

##############################################################################
# Stage 2: plots and analyses (allowed to fail individually)
##############################################################################
# Each step is independent of the next, so a missing input doesn't kill the
# pipeline -- the failure surfaces in the log and the rest still runs.
set +e

echo "=== 2a. per-experiment plots and comparison tables ==="
python code/plots.py --exp all --comparison

echo "=== 2b. grid plots ==="
python code/plots.py --exp grid

echo "=== 2c. geometry (CKA, identity Pearson) -- must precede tradeoff ==="
python code/analyse_geometry.py

echo "=== 2c.1 CKA vs retrieval scatter (per encoder pair, per recipe) ==="
python code/plot_cka_vs_retrieval.py --scope heldout
python code/plot_cka_vs_retrieval.py --scope aggregate

echo "=== 2d. rank-CDF (overlays both pairs) ==="
python code/analyse_ranks.py

echo "=== 2d.1 rank-distribution summary (bars, both scopes) ==="
python code/plot_rank_summary.py --scope heldout
python code/plot_rank_summary.py --scope aggregate

echo "=== 2e. multi-granularity AMI / category-recall ==="
python code/analyse_levels.py

echo "=== 2f. structure-vs-semantic trade-off plots ==="
python code/analyse_tradeoff.py

echo "=== 2f.1 all-recipes full-vs-heldout comparison ==="
python code/plot_full_vs_heldout.py

echo "=== 2f.2 transitive K-sweep at every alpha in the sweep grid ==="
for a in 0.0 0.3 0.5 0.7 0.9; do
    python code/plot_transitive_K_sweep.py --alpha "$a"
done

echo "=== 2f.3 extended core-set metrics table (canonical pair) ==="
# Reads per-(K, alpha) plans from results/exp_*/plans/ and the
# heldout_compare_idx from each experiment's directory; both are
# produced by the patched run_experiments.py in stage 1a.
python code/extended_metrics_table.py

echo "=== 2f.4 core-set scatter from the extended table ==="
python code/plot_extended_table.py

echo "=== 2f.5 alpha sweep: both regimes overlaid (Transitive at K=300) ==="
python code/plot_alpha_sweep.py --K 300

echo "=== 2f.6 per-leg alpha sweep: both regimes overlaid (legs A + B) ==="
python code/plot_legs_alpha_sweep.py --K 300

echo "=== 2f.7 coarse-to-fine alpha sweep, all recipes overlaid ==="
python code/plot_coarse_to_fine_alpha.py --K 300

echo "=== 2f.8 transitive alpha sweep at K=300 (in-formulation references) ==="
python code/plot_transitive_alpha_sweep.py --K 300

echo "=== 2f.9 per-leg retrieval vs alpha (linear-fit diagnostic) ==="
python code/plot_legs_alpha_linear.py --K 300

echo "=== 2f.10 FGW smoothing diagnostic (leg row entropy vs composed R@10) ==="
python code/plot_entropy_smoothing.py --K 300

echo "=== 2f.11 sharp/wide diagnostics: support, decay, diagonal mass, leg agreement ==="
python code/plot_effective_support.py --K 300
python code/plot_row_decay_profile.py --K 300
python code/plot_diagonal_mass.py --K 300
python code/plot_leg_topk_agreement.py --K 300

echo "=== 2f.12 spread of legs vs composed retrieval (inverted-U mediator plot) ==="
python code/plot_spread_vs_retrieval.py --K 300

echo "=== 2g. qualitative panels (canonical + text-free, both directions) ==="
python code/qualitative_panel.py --direction image_to_audio
python code/qualitative_panel.py --direction audio_to_image

echo "=== 2h. A/B grid tables ==="
python code/gen_ab_grids.py

echo "=== 2i. render best plans ==="
python code/render_best_plans.py

echo "=== 2j. assemble results chapter ==="
python code/gen_results_chapter.py

echo "=== inventory of generated figures ==="
ls -1 results/exp_grid/plots/*.png 2>/dev/null | wc -l \
    | xargs printf 'grid plots: %s PNGs\n'
ls -1 results/comparison_plots/*.png 2>/dev/null | wc -l \
    | xargs printf 'comparison plots: %s PNGs\n'

echo "=== done ==="
