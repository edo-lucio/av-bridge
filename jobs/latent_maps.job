#!/bin/bash
#SBATCH --job-name=avb-latmaps
#SBATCH --output=logs/latmaps_%j.out
#SBATCH --error=logs/latmaps_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:40:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

# Standalone "latent geometry" figures, all written to
# results/exp_grid/plots/:
#   embedding_maps__{img}__{aud}.png      UMAP + t-SNE of each space
#   transport_map__{recipe}__...__a*.png  the recovered OT alignment
#
# Reads only embeddings/{vision,audio}_*.npy (run code/encode.py first) and the
# saved couplings under results/exp_{c,d}*/plans/ (run code/run_experiments.py
# first). Runs no experiments and writes no sweep CSVs.
set -x

PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs results/exp_grid/plots

set +e

echo "=== embedding maps (UMAP + t-SNE), both encoder pairs ==="
python code/plot_embedding_maps.py --pair text-grounded
python code/plot_embedding_maps.py --pair text-free

echo "=== t-SNE cluster panel (why pure-GW fails: geometry mismatch) ==="
python code/plot_tsne_cluster_panel.py --pair text-grounded
python code/plot_tsne_cluster_panel.py --pair text-free

echo "=== transport panels: text-grounded (CLIP-L x CLAP-unfused) ==="
python code/plot_transport_maps.py --pair text-grounded --recipe transitive --K 300 --alpha 0.5
python code/plot_transport_maps.py --pair text-grounded --recipe caption --alpha 0.5

echo "=== transport panels: text-free (DINOv2-L x MERT-330m) ==="
python code/plot_transport_maps.py --pair text-free --recipe transitive --K 300 --alpha 0.9
python code/plot_transport_maps.py --pair text-free --recipe caption --alpha 0.9

echo "[done] latent-geometry figures in results/exp_grid/plots/"
ls -1 results/exp_grid/plots/embedding_maps__*.png \
       results/exp_grid/plots/tsne_cluster_panel__*.png \
       results/exp_grid/plots/transport_map__*.png 2>/dev/null
