#!/bin/bash
#SBATCH --job-name=avb-split-smoke
#SBATCH --output=logs/split_smoke_%j.out
#SBATCH --error=logs/split_smoke_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=END,FAIL

# Smoke test of the split-aware held-out mode on the EXISTING 400-clip
# embeddings (200 test + 200 val). No train.json, no GPU re-encode needed:
# held-out = val (200), leg anchors fall back to the test rows. CPU only
# (POT/numpy). Validates the new --heldout-split path end-to-end before the
# real scale-up.
set -e
set -x

PROJECT_DIR="${SLURM_SUBMIT_DIR:-$HOME/av-bridge}"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs

echo "=== sanity: embeddings present? ==="
ls -la embeddings/vision_clip-large.npy embeddings/audio_clap-unfused.npy \
       embeddings/ZV_text.npy embeddings/ZA_text.npy

echo "=== split smoke: c-transitive, held-out=val, pool<=800, throwaway suffix ==="
python code/run_experiments.py --exp c-transitive \
    --heldout-split val --max-pool 800 \
    --out-suffix __split_smoke

echo "=== held-out rows should be the 200 val clips (not ~30) ==="
python - <<'PY'
import pandas as pd
df = pd.read_csv("results/exp_c__split_smoke/sweep_transitive.csv")
h = df[df.scope == "heldout"]
print(h[["K", "alpha", "R@10", "cat_precision_10", "routes_total"]].to_string(index=False))
print("\nheldout rows scored per cell come from the val split (n=200).")
PY

echo "=== done ==="
